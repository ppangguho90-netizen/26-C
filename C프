// 2. 그래픽 및 출력 함수 관련
// ==========================================
void printShopScreen(const char* art[]) {
    printf("\033[2J\033[1;1f"); 
    for (int i = 0; i < 33; i++) {
        printf("%s\n", art[i]);
    }
}

void drawText(int r, int c, const char* text) {
    printf("\033[%d;%df%s", r, c, text);
}

void updateShopDisplay(const char* art[], int textR, int textC, const char* message) {
    printShopScreen(art);
    drawText(textR, textC, message);
    drawText(28, 10, "[ 아무 키나 눌러 돌아가기 ]");
    drawText(35, 1, "입력 대기: ");
    char dummy;
    scanf(" %c", &dummy);
}

// 나무 생성 함수 (경계값 체크 추가)
void makeTree(int map[MAP_ROWS][MAP_COLS], int row, int col) {
    if (row >= 4 && row < MAP_ROWS && col >= 1 && col < MAP_COLS - 1) {
        // 나무 기둥 (4)
        map[row][col] = 4;
        map[row - 1][col] = 4;
        map[row - 2][col] = 4;

        // 나뭇잎 (5)
        map[row - 2][col - 1] = 5;
        map[row - 2][col + 1] = 5;

        map[row - 3][col - 1] = 5;
        map[row - 3][col] = 5;
        map[row - 3][col + 1] = 5;

        map[row - 4][col] = 5;
    }
}

// 맵 출력 함수 (카메라)
void printCameraView(int map[MAP_ROWS][MAP_COLS], int player_r, int player_c, int inventory[9]) {
    char symbol[8][1024] = {
        "  ",
        "\033[42m  \033[0m",     // 1: 풀
        "\033[43m  \033[0m",     // 2: 흙
        "\033[100m  \033[0m",    // 3: 바위
        "\033[48;5;94m  \033[0m", // 4: 나무
        "\033[48;5;28m  \033[0m",  // 5: 나뭇잎
        "\033[44m  \033[0m",     // 6: 상점 벽
        "\033[46m문\033[0m"      // 7: 상점 문
    };

    // 깜빡임 방지: 화면 청소 대신 커서를 맨 위로 올려서 덮어쓰기/배웠나 모르겠음
    printf("\033[1;1f");

    for (int r = 0; r < 16; r++) {
        for (int c = 0; c < 25; c++) {
            int world_r = player_r + (r - 7);
            int world_c = player_c + (c - 12);

            // 좌우 맵 끝 무한
            if (world_c < 0) world_c += MAP_COLS;
            if (world_c >= MAP_COLS) world_c -= MAP_COLS;

            if (world_r < 0 || world_r >= MAP_ROWS) {
                printf("%s", symbol[0]);
            }
            else {
                int block_type = map[world_r][world_c];
                if (block_type >= 0 && block_type < 8) {
                    printf("%s", symbol[block_type]);
                }
                else {
                    printf("  ");
                }
            }
        }
        // 줄 바꿈 직전에 잔상 지우기
        printf("\033[K\n");
    }

    // 플레이어
    printf("\033[%d;%df옷", 7 + 1, 12 * 2 + 1);

    // 인벤토리 및 UI 출력
    printf("\033[18;1f\033[K[인벤토리] 1.풀:%d | 2.흙:%d | 3.바위:%d | 4.나무:%d | 5.나뭇잎:%d | \033[33m판자:%d 막대:%d 코인:%d\033[0m\n",
        inventory[1], inventory[2], inventory[3], inventory[4], inventory[5], inventory[6], inventory[7], inventory[8]);

    printf("\033[20;1f\033[K[이동: WASD | 파괴: F | 설치: 1~5 | 종료: P (상점은 x:31 부근)]\n\033[K");
}

