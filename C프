    while (1) {
        // ==========================================
        // 3-1. 상점 내부
        // ==========================================
        if (in_shop) {
            if (shop_state == 0) {
                printShopScreen(art_default);
                drawText(4, 9, "Q. 나가기");
                drawText(13, 23, "1. 교환하기");
                drawText(25, 23, "2. 대화하기");

                drawText(35, 1, "입력: ");
                scanf(" %c", &input);

                if (input == 'q' || input == 'Q') {
                    in_shop = 0;
                    player_r = door_r;
                    player_c = door_c + 1; // 상점에서 나올때 위치
                    if (player_c >= MAP_COLS) player_c -= MAP_COLS;

                    printf("\033[2J");
                }
                else if (input == '1') shop_state = 1;
                else if (input == '2') shop_state = 2;
            }
            else if (shop_state == 1) {
                printShopScreen(art_default);
                drawText(4, 9, "B. 뒤로가기");
                drawText(8, 10, "\033[1m[ 교환 목록 ]\033[0m");
                drawText(10, 10, "1. 나무(1) -> 나무판자(4)");
                drawText(11, 10, "2. 나무판자(2) -> 막대기(4)");
                drawText(12, 10, "3. 나무(1) -> 코인(1)");
                drawText(13, 10, "4. 바위(1) -> 코인(1)");

                drawText(35, 1, "입력: ");
                scanf(" %c", &input);

                if (input == 'b' || input == 'B') {
                    shop_state = 0;
                }
                else if (input >= '1' && input <= '4') {
                    int success = 0;

                    if (input == '1' && inventory[4] >= 1) { inventory[4] -= 1; inventory[6] += 4; success = 1; }
                    else if (input == '2' && inventory[6] >= 2) { inventory[6] -= 2; inventory[7] += 4; success = 1; }
                    else if (input == '3' && inventory[4] >= 1) { inventory[4] -= 1; inventory[8] += 1; success = 1; }
                    else if (input == '4' && inventory[3] >= 1) { inventory[3] -= 1; inventory[8] += 1; success = 1; }

                    if (success) {
                        updateShopDisplay(art_happy, 24, 10, "상인: 교환 완료! 감사합니다!");
                    }
                    else {
                        updateShopDisplay(art_panic, 24, 10, "상인: 이런... 재료가 부족한 것 같네요.");
                    }
                }
            }
            else if (shop_state == 2) {
                printShopScreen(art_default);
                drawText(4, 9, "B. 뒤로가기");
                drawText(8, 10, "\033[1m[ 대화 목록 ]\033[0m");
                drawText(10, 10, "1. 인사하기");
                drawText(11, 10, "2. 일상 대화");
                drawText(12, 10, "3. 칭찬하기");
                drawText(13, 10, "4. 팁");
                drawText(14, 10, "5. 코스튬 교환");

                drawText(35, 1, "입력: ");
                scanf(" %c", &input);

                if (input == 'b' || input == 'B') {
                    shop_state = 0;
                }
                else if (input >= '1' && input <= '5') {
                    if (input == '1') {
                        updateShopDisplay(art_happy, 24, 10, "상인: 어서오세요! 좋은 하루입니다!");
                    }
                    else if (input == '2') {
                        int r = rand() % 4;
                        if (r == 0)      updateShopDisplay(art_default, 24, 10, "상인: 오늘 참 날씨가 평화롭네요.");
                        else if (r == 1) updateShopDisplay(art_default, 24, 10, "상인: 탐험은 잘 진행되고 계신가요?");
                        else if (r == 2) updateShopDisplay(art_think, 24, 10, "상인: 흠... 요즘 손님이 부쩍 줄어서 큰일이네...");
                        else if (r == 3) updateShopDisplay(art_panic, 24, 10, "상인: 앗 깜짝이야! 방금 발 밑으로 벌레가 지나갔어요!!");
                    }
                    else if (input == '3') {
                        updateShopDisplay(art_shy, 24, 10, "상인: 헤헤... 그렇게 말씀해주시니 쑥스럽네요.");
                    }
                    else if (input == '4') {
                        printShopScreen(art_default);
                        drawText(23, 10, "\033[1m[ 조작법 안내 ]\033[0m");
                        drawText(24, 10, "- 이동: W, A, S, D");
                        drawText(25, 10, "- 블록 파괴: F");
                        drawText(26, 10, "- 블록 설치: G");
                        drawText(28, 10, "[ 아무 키나 눌러 돌아가기 ]");
                        drawText(35, 1, "입력 대기: ");
                        char dummy;
                        scanf(" %c", &dummy);
                    }
                    else if (input == '5') {
                        if (inventory[8] >= 100) {
                            updateShopDisplay(art_shy, 24, 10, "상인: 앗... 죄송해요! 아직 코스튬이 준비되지 않았어요.");
                        }
                        else {
                            printShopScreen(art_panic);
                            drawText(23, 10, "\033[1m[ 코스튬 교환 ]\033[0m");
                            drawText(25, 10, "상인: 코인 100개가 필요해요! (코인이 부족합니다)");
                            drawText(28, 10, "[ 아무 키나 눌러 돌아가기 ]");
                            drawText(35, 1, "입력 대기: ");
                            char dummy;
                            scanf(" %c", &dummy);
                        }
                    }
                }
            }
            continue;
        }

        // ==================================================================
        // 3-2. 상점 외부 필드
        // ==================================================================

        clock_t current_time = clock();
        if (current_time - start_time < (FRAME_DELAY * CLOCKS_PER_SEC / 1000)) continue;
        start_time = current_time;

        int move_dir = 0; // -1: 좌, 1: 우, 0: 정지
        int do_jump = 0;  // 1: 점프 시도

        // 1. 실시간 입력 감지(안배운거)
        while (_kbhit()) {
            input = _getch();

            if (input == 'p' || input == 'P') {
                printf("\033[2J\033[8;12f게임이 종료되었습니다.\033[22;1f\n\033[?25h");
                return 0; // 완전 종료
            }

            //이동 방향 저장
            if (input == 'w' || input == 'W') { facing = 'w'; do_jump = 1; }
            else if (input == 'a' || input == 'A') { facing = 'a'; move_dir = -1; }
            else if (input == 's' || input == 'S') { facing = 's'; }
            else if (input == 'd' || input == 'D') { facing = 'd'; move_dir = 1; }

            // 바라보는 방향
            int targetR = player_r;
            int targetC = player_c;
            if (facing == 'w') targetR--;
            else if (facing == 'a') targetC--;
            else if (facing == 's') targetR++;
            else if (facing == 'd') targetC++;

            // 맵 끝 무한 스크롤
            if (targetC < 0) targetC += MAP_COLS;
            if (targetC >= MAP_COLS) targetC -= MAP_COLS;

            // 블록 파괴 (F)
            if (input == 'f' || input == 'F') {
                if (targetR >= 0 && targetR < MAP_ROWS) {
                    int block = map[targetR][targetC];
                    if (block > 0 && block <= 5) {
                        inventory[block]++;
                        map[targetR][targetC] = 0;
                    }
                }
            }

            // 블록 설치 (1~5 숫자키 누르면 즉시 설치)
            if (input >= '1' && input <= '5') {
                int block_choice = input - '0';
                if (targetR >= 0 && targetR < MAP_ROWS) {
                    if (map[targetR][targetC] == 0 && inventory[block_choice] > 0) {
                        map[targetR][targetC] = block_choice;
                        inventory[block_choice]--;
                    }
                }
            }
        }

        // 2. 좌우 이동 적용
        if (move_dir == -1) {
            int nextC = player_c - 1;
            if (nextC < 0) nextC += MAP_COLS;
            if (map[player_r][nextC] == 0 || map[player_r][nextC] == 7) player_c = nextC;
        }
        else if (move_dir == 1) {
            int nextC = player_c + 1;
            if (nextC >= MAP_COLS) nextC -= MAP_COLS;
            if (map[player_r][nextC] == 0 || map[player_r][nextC] == 7) player_c = nextC;
        }

        // 3. 점프 트리거 (발밑에 블록이 있을 때만)
        if (do_jump && player_r < MAP_ROWS - 1 && map[player_r + 1][player_c] != 0) {
            jump_power = 3;
        }

        // 4. 물리 엔진 (중력 및 천장 충돌)
        if (jump_power > 0) {
            if (player_r > 0 && map[player_r - 1][player_c] == 0) player_r--;
            else jump_power = 0;
            jump_power--;
        }
        else {
            if (player_r < MAP_ROWS - 1 && map[player_r + 1][player_c] == 0) {
                player_r++;
            }
        }

        // 5. 상점 진입 확인 (7: 문 블록)
        if (map[player_r][player_c] == 7) {
            in_shop = 1;
            shop_state = 0;
            door_r = player_r;
            door_c = player_c;
        }

        // 6. 화면 렌더링
        printCameraView(map, player_r, player_c, inventory);
    } // while (1) 루프 닫힘

    return 0;
} // main 함수 닫힘
